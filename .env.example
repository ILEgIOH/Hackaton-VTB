# Скопируйте в .env (он в .gitignore) и заполните. Ключ нигде не коммитится.
# Вариант 1 — Claude (рекомендуется): base_url без /v1, ключ можно задать как ANTHROPIC_API_KEY
# CC_AI_BASE_URL=https://api.anthropic.com
# CC_AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...
# Российские: YandexGPT — CC_AI_BASE_URL=https://llm.api.cloud.yandex.net/v1, CC_AI_MODEL=gpt://<ID_каталога>/yandexgpt/latest, CC_AI_API_KEY=<API-ключ сервисного аккаунта>
#             GigaChat  — CC_AI_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1, CC_AI_MODEL=GigaChat, CC_AI_API_KEY=<Authorization key из кабинета>,
#                         CC_AI_CA_BUNDLE=путь к сертификату Минцифры (russian_trusted_root_ca.pem)
# Вариант 2 — любой OpenAI-совместимый API (OpenAI, OpenRouter, Groq, Ollama)
CC_AI_API_KEY=
CC_AI_BASE_URL=https://api.openai.com/v1
CC_AI_MODEL=gpt-4o-mini
# Почта для писем в ЦОД и заёмщику (без этого письма сохраняются в журнале data/db.json -> outbox)
# CC_SMTP_HOST=smtp.example.com
# CC_SMTP_PORT=587
# CC_SMTP_USER=
# CC_SMTP_PASSWORD=
# CC_SMTP_FROM=collateral@bank.ru
