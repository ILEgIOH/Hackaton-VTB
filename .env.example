# Скопируйте в .env (он в .gitignore) и заполните. Ключ нигде не коммитится.
# Вариант 1 — GigaChat (рекомендуется): CC_AI_BASE_URL=https://api.giga.chat/v1, CC_AI_MODEL=GigaChat-2-Max, CC_AI_API_KEY=<Authorization key из кабинета>,
#                         CC_AI_CA_BUNDLE=путь к сертификату Минцифры (russian_trusted_root_ca.pem)
# Вариант 2 — любой OpenAI-совместимый API (OpenAI, OpenRouter, Groq, Ollama)
CC_AI_API_KEY=
# CC_AI_BASE_URL=https://api.openai.com/v1
# CC_AI_MODEL=gpt-4o-mini
# По умолчанию включена заглушка ИИ (stub://local) — ключ не нужен. Раскомментируйте строки выше, чтобы подключить реальный API.
# Почта для писем в ЦОД и заёмщику (без этого письма сохраняются в журнале data/db.json -> outbox)
# CC_SMTP_HOST=smtp.example.com
# CC_SMTP_PORT=587
# CC_SMTP_USER=
# CC_SMTP_PASSWORD=
# CC_SMTP_FROM=collateral@bank.ru
# GigaChat: scope ключа — GIGACHAT_API_PERS (физлицо), GIGACHAT_API_CORP / GIGACHAT_API_B2B (организация)
# CC_GIGACHAT_SCOPE=GIGACHAT_API_PERS

# ---- Безопасность и закрытый контур (Спринт 2) ----
# CC_ONPREM=1                 закрытый контур: ИИ и SMTP только на внутренних адресах, агенты — только с подписью
# CC_ALLOWED_HOSTS=llm.bank.local,smtp.bank.local   внутренние имена, разрешённые в контуре
# CC_AGENT_SIGNED_ONLY=1      принимать только подписанные пакеты агентов (HMAC-SHA256)
# CC_AI_DEIDENTIFY=1          обезличивать снимок для ИИ (по умолчанию включено)
# CC_STOPLIST=/data/stoplist.csv   перечень ИНН для проверки по 115-ФЗ (формат: ИНН;основание)
# CC_TELEMETRY_DAYS=400       срок хранения истории телеметрии
# CC_SESSION_MIN=30           время жизни сессии без действий
# CC_HTTPS=1                  сервис за TLS-балансировщиком: cookie с флагом Secure
