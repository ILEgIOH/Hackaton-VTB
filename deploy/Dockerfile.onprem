# ComputeCollateral — образ для развёртывания в контуре банка (on-prem).
# Сборка из корня репозитория: docker build -f deploy/Dockerfile.onprem -t computecollateral .
# Dockerfile в корне — публичное демо для Render (CC_PUBLIC_DEMO=1).
# База — официальный python:3.12-slim; для контура банка её можно заменить на образ из реестра банка
# на отечественной ОС (Astra Linux, РЕД ОС, ALT) — приложение использует только Python и стандартную библиотеку.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    CC_DATA_DIR=/data CC_ONPREM=1 CC_AGENT_SIGNED_ONLY=1
WORKDIR /app

COPY requirements.txt .
RUN grep -v pywebview requirements.txt > /tmp/req.txt && pip install --no-cache-dir -r /tmp/req.txt

COPY compute_collateral ./compute_collateral
COPY web ./web
COPY agent ./agent
COPY run.py .

RUN useradd --system --uid 10001 cc && mkdir -p /data && chown cc /data
USER cc
VOLUME ["/data"]
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8765/api/health',timeout=3)"
CMD ["python", "run.py", "--no-window", "--host", "0.0.0.0", "--port", "8765"]
